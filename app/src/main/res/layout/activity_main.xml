<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/on_blue"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home Assistant calendars on your phone"
                    android:textColor="@color/on_blue_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Status -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="Status" />

                <TextView
                    android:id="@+id/status"
                    style="@style/Caption"
                    android:layout_marginTop="6dp"
                    android:text="Not set up yet"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <!-- Connection -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="Connection" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="Home Assistant URL" />

                <EditText
                    android:id="@+id/url"
                    style="@style/Input"
                    android:hint="https://homeassistant.example.com"
                    android:inputType="textUri|textNoSuggestions" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="Long-lived access token" />

                <!-- No autofill and no keyboard learning (set in the Input style). -->
                <EditText
                    android:id="@+id/token"
                    style="@style/Input"
                    android:inputType="textPassword|textNoSuggestions" />

                <Button
                    android:id="@+id/connect"
                    style="@style/Button.Outline"
                    android:layout_marginTop="20dp"
                    android:text="Connect &amp; load calendars" />
            </LinearLayout>

            <!-- Calendars -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="Calendars to sync" />

                <TextView
                    style="@style/Caption"
                    android:layout_marginTop="4dp"
                    android:text="Connect to load the calendars from Home Assistant." />

                <LinearLayout
                    android:id="@+id/calendar_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Options -->
            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="Options" />

                <Switch
                    android:id="@+id/open_in_ha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="Show &quot;Open in Home Assistant&quot; on events"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Caption"
                    android:text="Launchers and widgets (e.g. Niagara): tap an event and choose &quot;Open in Home Assistant&quot;. HA events open the page below; other events go to your usual calendar app. Some calendar apps (e.g. Etar) also show an &quot;Open in…&quot; link on HA events." />

                <!-- Only visible while the switch is on -->
                <LinearLayout
                    android:id="@+id/open_path_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="Page to open" />

                    <EditText
                        android:id="@+id/open_path"
                        style="@style/Input"
                        android:hint="/calendar"
                        android:inputType="textUri|textNoSuggestions" />

                    <TextView
                        style="@style/Caption"
                        android:layout_marginTop="6dp"
                        android:text="Open the dashboard view you want in a browser and copy the part after your HA address, e.g. /dashboard-family/calendar. You can also paste the full link. Leave empty for the built-in Calendar page." />
                </LinearLayout>
            </LinearLayout>

            <!-- Actions -->
            <Button
                android:id="@+id/save"
                style="@style/Button.Primary"
                android:layout_marginTop="24dp"
                android:text="Save &amp; sync" />

            <Button
                android:id="@+id/sync_now"
                style="@style/Button.Outline"
                android:layout_marginTop="12dp"
                android:text="Sync now" />

            <Button
                android:id="@+id/remove"
                style="@style/Button.Danger"
                android:layout_marginTop="8dp"
                android:text="Remove account" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
